# LIMYÈ — copy to ``.env`` at repo root or ``limye_api/.env`` (not committed)

APP_NAME=
ENV=

# PostgreSQL (e.g. Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

DEEPSEEK_API_KEY=
QWEN_API_KEY=

GOOGLE_SOLAR_API_KEY=
MAPBOX_ACCESS_TOKEN=
NREL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Proposal email (POST /api/v1/save-design). Use 465 + implicit SSL or 587 + STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LIMYÈ
SMTP_USE_TLS=true

REDIS_URL=
SOLANA_RPC_URL=

CORS_ORIGINS=
LOG_LEVEL=
